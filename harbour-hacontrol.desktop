[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-hacontrol
Exec=harbour-hacontrol
Name=HA Control
# translation example:
# your app name in German locale (de)
#
# Remember to comment out the following line, if you do not want to use
# a different app name in German locale (de).
Name[de]=HA Control

[X-Sailjail]
# Replace with your organization as a reverse domain name
OrganizationName=org.example
# ApplicationName does not have to be identical to Name
ApplicationName=hacontrol
# Only local-network HTTP(S) to the Home Assistant instance is needed for
# Ausbaustufe 1 -- Secrets added for encrypted credential storage (see
# KONZEPT.md's Sailfish-Secrets migration).
Permissions=Internet;Secrets;
# Notification buttons call org.example.hacontrol (OrganizationName +
# ApplicationName) over D-Bus. With ExecDBus, sailjaild writes the D-Bus
# activation file for that name itself (/run/user/<uid>/dbus-1/services/,
# Exec=/usr/bin/invoker --type=silica-qt5 --single-instance ...), so a button
# also works when the app isn't running. Harbour only accepts the bare binary
# name (plus at most one plain argument) here, and no own .service file.
ExecDBus=harbour-hacontrol
